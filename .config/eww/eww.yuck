
;; j-sketch eww bar - SketchyBar clone for jdotfiles
(deflisten hypr :initial '{"workspaces":[],"frontapp":""}' "~/.config/eww/scripts/hypr.py")
(defpoll media :interval "2s" "~/.config/eww/scripts/media.sh")
(defpoll volume :interval "1s" "~/.config/eww/scripts/volume.sh")
(defpoll wifi :interval "3s" "~/.config/eww/scripts/wifi.sh")
(defpoll clock :interval "5s" "~/.config/eww/scripts/clock.sh")
(defpoll caffeine :interval "2s" "~/.config/eww/scripts/caffeine.sh")
(defpoll bt :interval "5s" "~/.config/eww/scripts/bt.sh")

(defwidget spaces []
  (box :class "pill spacespill" :orientation "h" :space-evenly false :spacing 2
    (label :class "archlogo" :text "")
    (for ws in {hypr.workspaces}
      (button :class {ws.active ? "ws active" : ws.occupied ? "ws occ" : "ws"}
              :valign "center"
              :onclick "hyprctl dispatch workspace ${ws.id}"
              "${ws.id}"))))

(defwidget frontapp []
  (box :class "pill frontpill" :visible {hypr.frontapp != ""}
    (label :class "frontapp" :text "›  ${hypr.frontapp}")))

(defwidget mediapill []
  (box :class "pill mediapill" :visible {media != ""}
    (button :class "mediabtn" :onclick "playerctl play-pause"
      (label :text media))))

(defwidget wifipill []
  (box :class "pill" :visible {wifi != ""}
    (label :class "wifilabel" :text "  ${wifi}")))

(defwidget volpill []
  (box :class "pill volpill"
    (button :class "volbtn"
            :onclick "~/.config/eww/scripts/voltoggle.sh"
            :onrightclick "pavucontrol &"
      (label :class {volume.muted ? "volicon muted" : "volicon"} :text "${volume.icon}  ${volume.vol}%"))))

(defwidget btpill []
  (box :class "pill btpill"
    (label :class {bt == "on" ? "bticon on" : "bticon"} :text "")))

(defwidget caffpill []
  (box :class "pill caffpill"
    (button :class "caffbtn" :onclick "~/.config/waybar/settings/caffeine-toggle.sh &"
      (label :class {caffeine == "on" ? "coffee on" : "coffee off"} :text "☕"))))

(defwidget clockpill []
  (box :class "pill clockpill" :orientation "h" :space-evenly false :spacing 0
    (label :class "clocktime" :text {clock.time})
    (label :class "clocksep" :text "   ·   ")
    (label :class "clockdate" :text {clock.date})))

(defwidget barroot []
  (box :class "barroot" :orientation "h" :space-evenly false
    (box :class "side" :orientation "h" :halign "start" :space-evenly false :spacing 4
      (spaces)
      (frontapp)
      (mediapill))
    (box :class "side" :orientation "h" :halign "end" :hexpand true :space-evenly false :spacing 4
      (wifipill)
      (volpill)
      (btpill)
      (caffpill)
      (clockpill))))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "46px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (barroot))

(defwidget volpoproot []
  (box :class "volpop" :orientation "h" :space-evenly false :spacing 10
    (label :class "volicon" :text {volume.icon})
    (scale :class "volscale" :min 0 :max 100 :value {volume.vol}
           :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
    (label :class "volpct" :text "${volume.vol}%")
    (button :class "popclose" :onclick "~/.config/eww/scripts/popclose.sh" "×")))

(defwindow volpopup
  :monitor 0
  :geometry (geometry :x "150px" :y "52px" :width "300px" :height "58px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (volpoproot))
