
;; j-sketch eww bar - 1:1 port of Q's SketchyBar config (metrics from the Lua source)
(deflisten hypr :initial '{"workspaces":[],"frontapp":""}' "~/.config/eww/scripts/hypr.py")
(defpoll media :interval "2s" "~/.config/eww/scripts/media.sh")
(defpoll volume :interval "1s" "~/.config/eww/scripts/volume.sh")
(defpoll wifi :interval "3s" "~/.config/eww/scripts/wifi.sh")
(defpoll clock :interval "5s" "~/.config/eww/scripts/clock.sh")
(defpoll caffeine :interval "2s" "~/.config/eww/scripts/caffeine.sh")
(defpoll bt :interval "5s" "~/.config/eww/scripts/bt.sh")

(defwidget spaces []
  (box :class "pill" :orientation "h" :space-evenly false :spacing 0 :valign "center"
    (label :class "archlogo" :text "")
    (box :class "sep" :orientation "v" :space-evenly false)
    (box :orientation "h" :space-evenly false :spacing 0
      (for ws in {hypr.workspaces}
        (button :class {ws.active ? "ws active" : ws.occupied ? "ws occ" : "ws"}
                :valign "center"
                :onclick "hyprctl dispatch workspace ${ws.id}"
                "${ws.id}")))))

(defwidget frontapp []
  (box :class "pill" :orientation "h" :space-evenly false :spacing 0 :valign "center"
       :visible {hypr.frontapp != ""}
    (label :class "frontchev" :text "")
    (label :class "frontlabel" :text {hypr.frontapp})))

(defwidget mediapill []
  (box :class "pill" :orientation "h" :space-evenly false :spacing 0 :valign "center"
    (button :class "mediabtn" :onclick "playerctl play-pause"
      (label :class "mediaicon" :text {media.playing ? "󰏤" : "󰐊"}))
    (label :class {media.playing ? "medialabel" : "medialabel muted"} :text {media.text})))

(defwidget wifipill []
  (box :class "pill" :orientation "h" :space-evenly false :spacing 0 :valign "center"
       :visible {wifi.ssid != ""}
    (label :class "wifiicon" :text {wifi.icon})
    (label :class "wifilabel" :text {wifi.ssid})))

(defwidget volpill []
  (box :class "pill" :orientation "h" :space-evenly false :spacing 0 :valign "center"
    (button :class "volbtn"
            :onclick "~/.config/eww/scripts/voltoggle.sh"
            :onrightclick "pavucontrol &"
      (label :class "volicon" :text {volume.icon}))
    (scale :class "volmeter" :min 0 :max 100 :value {volume.vol}
           :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")))

(defwidget caffpill []
  (box :class {caffeine == "on" ? "pill caffpill on" : "pill caffpill"} :valign "center"
    (button :class "caffbtn" :onclick "~/.config/waybar/settings/caffeine-toggle.sh &"
      (label :class {caffeine == "on" ? "cafficon on" : "cafficon off"} :text ""))))

(defwidget clockpill []
  (box :class "pill" :orientation "h" :space-evenly false :spacing 0 :valign "center"
    (label :class "clocktime" :text {clock.time})
    (label :class "clockdot" :text "•")
    (label :class "clockdate" :text {clock.date})))

(defwidget btpill []
  (box :class "pill" :valign "center"
    (label :class {bt == "on" ? "bticon on" : "bticon"} :text "󰂯")))

(defwidget barroot []
  (box :class "barroot" :orientation "h" :space-evenly false
    (box :class "side" :orientation "h" :halign "start" :space-evenly false :spacing 4
      (spaces)
      (frontapp)
      (mediapill))
    (box :class "side" :orientation "h" :halign "end" :hexpand true :space-evenly false :spacing 4
      (wifipill)
      (volpill)
      (caffpill)
      (clockpill)
      (btpill))))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "38px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (barroot))

(defwidget volpoproot []
  (box :class "volpop" :orientation "h" :space-evenly false :spacing 10
    (label :class "volicon pop" :text {volume.icon})
    (scale :class "volscale" :min 0 :max 100 :value {volume.vol}
           :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
    (label :class "volpct" :text "${volume.vol}%")
    (button :class "popclose" :onclick "~/.config/eww/scripts/popclose.sh" "×")))

(defwindow volpopup
  :monitor 0
  :geometry (geometry :x "150px" :y "46px" :width "300px" :height "58px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (volpoproot))
