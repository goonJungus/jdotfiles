#!/bin/bash
# dots - hot-swap dotfiles sets without logging out.
# Usage: dots          -> show the active set
#        dots jdotfiles | dots <folder in ~>
APPS=(hypr waybar eww kitty rofi swaync wlogout waypaper zunder tfm)

if [ -z "$1" ]; then
    cur=$(readlink ~/.config/hypr)
    echo "active: $(basename "$(dirname "$(dirname "$cur")")")"
    exit 0
fi

case "$1" in
    *)    TARGET="$HOME/$1" ;;
esac

if [ ! -d "$TARGET/.config/hypr" ]; then
    echo "dots: no dotfiles set at $TARGET"
    exit 1
fi

for a in "${APPS[@]}"; do
    if [ -e "$TARGET/.config/$a" ]; then
        ln -sfn "$TARGET/.config/$a" "$HOME/.config/$a"
    fi
done

# Live-apply everything that can reload without a logout.
# When run from outside the GUI session (e.g. SSH), import the session env first.
if [ -z "$WAYLAND_DISPLAY" ]; then
    eval "$(systemctl --user show-environment 2>/dev/null | grep -E '^(WAYLAND_DISPLAY|DISPLAY|DBUS_SESSION_BUS_ADDRESS)=' | sed 's/^/export /')"
    export XDG_RUNTIME_DIR=/run/user/$(id -u)
fi
SIG=$(ls "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -1)
if [ -n "$SIG" ]; then
    HYPRLAND_INSTANCE_SIGNATURE=$SIG hyprctl reload >/dev/null 2>&1
fi
# The active set's bar.sh is the bar authority (eww in jdotfiles);
# sets without one fall back to waybar.
if [ -x "$HOME/.config/hypr/scripts/bar.sh" ]; then
    ("$HOME/.config/hypr/scripts/bar.sh" restart >/dev/null 2>&1 &)
else
    pkill waybar 2>/dev/null
    ("$HOME/.config/waybar/launch.sh" >/dev/null 2>&1 &)
fi
pkill swaync 2>/dev/null
(swaync >/dev/null 2>&1 &)
pkill -f 2>/dev/null
killall -SIGUSR1 kitty 2>/dev/null

echo "dots: now on $1"
